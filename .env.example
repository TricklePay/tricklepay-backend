# TricklePay backend configuration.
#
# Copy this file to `.env` and fill in the two required values. Every other
# setting is optional and shown here with its default; uncommented optional
# values match what the service uses when they are left unset.

# ---------------------------------------------------------------------------
# Required — the service refuses to start without these.
# ---------------------------------------------------------------------------

# Postgres connection string.
DATABASE_URL=postgresql://tricklepay:tricklepay@localhost:5432/tricklepay

# Deployed stream contract id to index: a Soroban contract address (StrKey,
# 56 characters, starts with "C"). No default.
STREAM_CONTRACT_ID=

# ---------------------------------------------------------------------------
# Optional — network and RPC.
# ---------------------------------------------------------------------------

# Stellar network to talk to: testnet or mainnet. Default: testnet.
NETWORK=testnet

# Soroban RPC endpoint. Defaults to the public endpoint for NETWORK:
#   testnet -> https://soroban-testnet.stellar.org
#   mainnet -> https://mainnet.sorobanrpc.com
# Plain http:// is only accepted for loopback endpoints (localhost / 127.x.x.x / [::1]).
#SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ---------------------------------------------------------------------------
# Optional — HTTP server.
# ---------------------------------------------------------------------------

# Listen port and bind address. Defaults: PORT=3000, HOST=0.0.0.0.
PORT=3000
HOST=0.0.0.0

# Allowed browser origin for the web client. Unset reflects any origin, which
# suits local dev; pin this to the frontend's URL in a deployment.
CORS_ORIGIN=

# Base URL advertised in the generated OpenAPI document (the "servers"
# entry), so client generators and readers know where the API lives. Unset
# derives it from HOST and PORT (e.g. http://localhost:3000); set it to the
# public URL when the service sits behind a proxy or custom hostname.
PUBLIC_BASE_URL=

# Log verbosity: trace, debug, info, warn, error, fatal, or silent (case-
# insensitive). Default: info. Any other value is rejected at startup.
LOG_LEVEL=info

# Set to true for human-readable logs while developing (requires the
# pino-pretty dev dependency). Leave unset in production, where logs are JSON.
# LOG_PRETTY=true

# Largest accepted request body in bytes. Default: 1048576 (1 MiB).
BODY_LIMIT=1048576

# Longest accepted URL query string, in bytes. Default: 2048 (2 KiB).
# Repeating a parameter in that string is rejected with 400 (see
# docs/query-parameters.md), so a duplicated filter is never silently dropped.
QUERY_STRING_LIMIT=2048

# Optional — interactive API documentation.
#
# "false" disables only the Swagger UI at /docs, including its static assets.
# The machine-readable document stays available at /docs/json and /docs/yaml.
# Accepts true/false (also 1/0, yes/no, on/off). Default: true.
ENABLE_DOCS_UI=true

# Optional — bearer token for the metrics endpoint.
#
# When set, /metrics requires "Authorization: Bearer <token>" and returns 401
# otherwise. When empty, the endpoint is unauthenticated, as before. The token is
# compared in constant time, but it is an extra layer only: keep /metrics off
# the public network and send the token over TLS.
METRICS_TOKEN=

# Responses at least this many bytes are compressed when the client sends
# Accept-Encoding: gzip or br. Larger responses shrink substantially; smaller
# ones are left uncompressed because the encoding overhead would outweigh the
# saving. Must be a non-negative integer. Default: 1024 (1 KiB).
COMPRESSION_THRESHOLD_BYTES=1024

# Maximum requests allowed per client IP in each rate-limit window, and the
# length of that fixed window in milliseconds. Both must be greater than zero.
# Defaults: RATE_LIMIT_MAX=100, RATE_LIMIT_WINDOW_MS=60000 (1 minute).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Comma-separated list of trusted reverse-proxy addresses (IPs or IPv4 CIDR
# blocks), e.g. "10.0.0.5,10.0.1.0/24". Forwarded headers (X-Forwarded-For,
# X-Forwarded-Proto) are honored only when the direct connection peer is in
# this list; leave unset for direct exposure so clients cannot spoof the
# recorded client address (#75).
TRUSTED_PROXIES=

# Seconds advertised in the Retry-After header when GET /ready answers 503,
# so orchestrators and load balancers know how long to wait before probing
# again (e.g. while a long backfill is still in progress). Must be a
# non-negative integer. Default: 5.
READINESS_RETRY_AFTER_SECONDS=5

# ---------------------------------------------------------------------------
# Optional — indexer tuning.
# ---------------------------------------------------------------------------

# Summary aggregate cache window in milliseconds. Set to 0 to disable caching.
STREAM_SUMMARY_CACHE_TTL_MS=2000

# Milliseconds between polls of the chain once caught up. Minimum 1000;
# smaller values are rejected so the indexer cannot hammer the RPC.
INDEXER_POLL_INTERVAL_MS=5000

# Maximum poll retry delay (ms) when the RPC keeps failing. After a failure the
# wait doubles (2×, 4×, 8× …) up to this ceiling, then resets to the normal
# interval after a successful poll. Prevents hammering an unavailable RPC.
INDEXER_BACKOFF_MAX_MS=60000

# Ledger to begin indexing from for a backfill. 0 (or unset) starts from the
# chain's latest ledger at startup instead of replaying history.
INDEXER_START_LEDGER=0

# Maximum number of event pages fetched per poll tick. A large backlog is split
# across ticks so a single poll cannot run indefinitely; the cursor is persisted
# after every page, so the next tick resumes where it stopped. Default: 1000.
INDEXER_MAX_PAGES_PER_TICK=1000
