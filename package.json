{
  "name": "tricklepay-backend",
  "version": "0.1.0",
  "description": "Indexer and read API for TricklePay token streams on Stellar",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "replay-failed-events": "tsx src/indexer/replay.ts",
    "prune-failed-events": "tsx src/indexer/prune.ts",
    "print-config": "tsx src/print-config.ts",
    "depcheck": "depcheck",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@prisma/client": "6.19.3",
    "@stellar/stellar-sdk": "17.4.0",
    "fastify": "^5.12.8",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "~13.1.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "~4.1.10",
    "depcheck": "^1.4.7",
    "pino-pretty": "^13.2.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
